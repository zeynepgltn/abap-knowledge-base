@model Note
@using ABAPKnowledgeBase.Services
@{ ViewData["Title"] = "Yeni not"; ViewData["TCode"] = TCodes.NewNote; ViewData["Description"] = "Yeni ABAP notu: açıklama, kod örneği, resim ve kategori."; }
<section class="screen-head"><div class="screen-title"><span class="tcode">@TCodes.NewNote</span><h1>Yeni ABAP notu</h1></div><p class="muted">Notunu gir, kategoriyi önerelim, onaylayıp kaydet.</p></section><form asp-action="Create" method="post" enctype="multipart/form-data" class="form-card">@Html.AntiForgeryToken()@if (ViewBag.Inline is true) { <input type="hidden" name="inline" value="true" /> }<partial name="_Fields" model="Model" /></form>
