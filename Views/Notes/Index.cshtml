@model List<ABAPKnowledgeBase.Models.Note>
@using ABAPKnowledgeBase.Controllers
@using ABAPKnowledgeBase.Services
@using ABAPKnowledgeBase.Models
@using System.Linq
@{
    var categories = ViewBag.CategoryOverviews as List<NotesController.CategoryOverview> ?? new();
    int? selectedCategory = ViewBag.SelectedCategory;
    int? selectedNoteId = ViewBag.SelectedNote;
    string? query = ViewBag.Query;
    string? categoryName = ViewBag.CategoryName;
    bool isListing = selectedCategory.HasValue || !string.IsNullOrWhiteSpace(query);
    int totalNotes = ViewBag.TotalNotes ?? 0;
    var selectedNote = Model.FirstOrDefault(n => n.Id == selectedNoteId) ?? Model.FirstOrDefault();
    bool editing = ViewBag.Edit is true && selectedNote is not null;
    bool creating = ViewBag.Create is true;
    // Projeler kategorisinin alt alanı: firmalar
    int? projectsId = ViewBag.ProjectsCategoryId;
    var companies = ViewBag.Companies as List<NotesController.CategoryOverview> ?? new();
    int? selectedCompany = ViewBag.SelectedCompany;
    string? companyName = ViewBag.CompanyName;
    bool canReorder = ViewBag.CanReorder is true;
    // Alt kategoriler: kategori açıkken (arama değilken) sayfalar alt kategori başlıkları altında gruplanır.
    // Liste sırası: önce Genel (alt kategorisi olmayanlar, varsa), sonra alt kategoriler kendi sırasıyla.
    var subcategories = ViewBag.Subcategories as List<Subcategory> ?? new();
    bool grouped = subcategories.Count > 0;
    var listItems = new List<(Subcategory? Group, bool IsHead, Note? Note, int Count)>();
    if (grouped)
    {
        var general = Model.Where(n => n.SubcategoryId is null).ToList();
        listItems.Add((null, true, null, general.Count));
        listItems.AddRange(general.Select(n => ((Subcategory?)null, false, (Note?)n, 0)));
        foreach (var s in subcategories)
        {
            var inGroup = Model.Where(n => n.SubcategoryId == s.Id).ToList();
            listItems.Add((s, true, null, inGroup.Count));
            listItems.AddRange(inGroup.Select(n => ((Subcategory?)s, false, (Note?)n, 0)));
        }
    }
    else listItems.AddRange(Model.Select(n => ((Subcategory?)null, false, (Note?)n, 0)));
    // Arama: sonuç sayıları, filtre seçenekleri ve her sonucun pasajı
    bool searching = !string.IsNullOrWhiteSpace(query);
    string? selectedTag = ViewBag.SelectedTag;
    var hits = ViewBag.SearchHits as Dictionary<int, NoteSearch.Hit> ?? new();
    var categoryFacets = ViewBag.CategoryFacets as List<NotesController.CategoryOverview> ?? new();
    var tagFacets = ViewBag.TagFacets as List<(string Tag, int Count)> ?? new();
    int resultTotal = ViewBag.ResultTotal ?? 0;
    int resultCount = ViewBag.ResultCount ?? 0;
    if (isListing) { ViewData["Wide"] = true; }
    var categoryCode = categoryName is null ? null : TCodes.ForCategory(categoryName);
    ViewData["Home"] = !isListing;
    ViewData["TCode"] = categoryCode ?? TCodes.Home;
    ViewData["Title"] = searching ? $"“{query!.Trim()}” araması" : isListing ? (selectedNote is not null ? $"{selectedNote.Title} · {categoryName}" : categoryName) : "Notlarım";
    ViewData["Description"] = searching ? $"“{query!.Trim()}” için {resultCount} not bulundu."
        : isListing ? $"{categoryName}: {Model.Count} sayfa ABAP notu." + (selectedNote is not null ? $" Açık not: {selectedNote.Title}." : "")
        : $"{categories.Count} kategoride {totalNotes} ABAP notu. İşlem koduyla git ya da ara.";
}
@if (!isListing)
{
    @* Ana ekran (SAP Easy Access gibi): büyük komut alanı ve Z-kodlu kategori indeksi. *@
    <section class="home-hero" aria-labelledby="home-title">
        <h1 id="home-title" class="display">Ne açalım?</h1>
        <form method="get" action="/" class="okcode okcode-xl" role="search" data-okcode-form>
            <label class="sr-only" for="okcode-home">İşlem kodu veya arama</label>
            <input id="okcode-home" name="q" list="tcodes" autocomplete="off" spellcheck="false" placeholder="ZALV, REDUCE, ?= …" data-okcode />
            <span class="okcode-caret" aria-hidden="true"></span>
            <button type="submit" class="action"><span>Çalıştır</span></button>
        </form>
        <p class="home-hints"><kbd>ZQUIZ</kbd> günün quiz'i <kbd>ZYENI</kbd> yeni not <span class="hint-key"><kbd>/</kbd> her ekrandan bu alana getirir</span></p>
    </section>
    <section class="tindex" aria-labelledby="tindex-title">
        <div class="tindex-head"><h2 id="tindex-title">Kategoriler</h2><p class="muted">@categories.Count kategori, @totalNotes not</p></div>
        <ul class="tindex-list">
        @foreach (var c in categories)
        {
            <li><a class="trow" asp-action="Index" asp-route-category="@c.Id"><span class="tcode">@TCodes.ForCategory(c.Name)</span><span class="trow-name">@c.Name</span><span class="trow-count">@c.NoteCount<span class="sr-only"> not</span></span><span class="trow-go" aria-hidden="true">↵</span></a></li>
        }
        </ul>
    </section>
}
else
{
    <section class="screen-head">
        <div class="screen-title"><span class="tcode">@(categoryCode ?? "ARAMA")</span><h1>@(searching ? $"“{query!.Trim()}” için {resultCount} sonuç" : categoryName)@if (companyName is not null) { <span class="hero-sub"> › @companyName</span> }</h1></div>
        <p class="muted">@(searching ? "En ilgili sonuçlar üstte. Kategori veya etiket seçerek daraltabilirsin. Joker: * birden çok harf, + tek harf (rs*abap*, *çelik*)." : $"{Model.Count} sayfa. Soldan bir sayfa seç, tam içeriği sağda açılır.")</p>
    </section>
    <form method="get" asp-action="Index" class="search">
        <label class="sr-only" for="scope-search">@(selectedCategory.HasValue && !searching ? "Bu kategoride ara" : "Notlarda ara")</label>
        <input id="scope-search" type="search" name="q" value="@query" placeholder="@(selectedCategory.HasValue && !searching ? $"{categoryName} içinde ara" : "Başlık, kod veya açıklama ara")" />
        @if (selectedCategory.HasValue) { <input type="hidden" name="category" value="@selectedCategory" /> }
        @if (selectedCompany.HasValue) { <input type="hidden" name="company" value="@selectedCompany" /> }
        <button type="submit">Ara</button>
    </form>
    @if (searching && resultTotal > 0)
    {
        @* Arama filtreleri: sayılar sonuçlardan hesaplanır; "Tümü" filtreyi kaldırır. *@
        <div class="facets">
            <div class="facet-row"><span class="facet-label">Kategori</span>
                <a class="chip @(selectedCategory is null ? "active" : "")" asp-action="Index" asp-route-q="@query">Tümü <b>@resultTotal</b></a>
                @foreach (var f in categoryFacets)
                {
                    <a class="chip @(f.Id == selectedCategory ? "active" : "")" asp-action="Index" asp-route-q="@query" asp-route-category="@f.Id">@f.Name <b>@f.NoteCount</b></a>
                }
            </div>
            @if (tagFacets.Count > 0)
            {
                <div class="facet-row"><span class="facet-label">Etiket</span>
                    <a class="chip @(selectedTag is null ? "active" : "")" asp-action="Index" asp-route-q="@query" asp-route-category="@selectedCategory">Tümü</a>
                    @foreach (var t in tagFacets)
                    {
                        <a class="chip @(string.Equals(t.Tag, selectedTag, StringComparison.OrdinalIgnoreCase) ? "active" : "")" asp-action="Index" asp-route-q="@query" asp-route-category="@selectedCategory" asp-route-tag="@t.Tag">@t.Tag <b>@t.Count</b></a>
                    }
                </div>
            }
        </div>
    }
    <a class="back-link" asp-action="Index"><span aria-hidden="true">←</span> Tüm kategoriler</a>
    @* Üç kolon: soldan sağa kategoriler, sayfalar, not. *@
    <div class="reading-layout">
        <aside class="note-sidebar category-sidebar" aria-label="Kategoriler">
           <div class="sidebar-top"><h2>Kategoriler</h2><span>@totalNotes not</span></div>
           <nav class="note-list">
           @foreach (var c in categories)
           {
               <a class="category-row @(c.Id == selectedCategory ? "active" : "")" asp-action="Index" asp-route-category="@c.Id" aria-current="@(c.Id == selectedCategory ? "page" : null)">
                   <span class="tcode tcode-s">@TCodes.ForCategory(c.Name)</span><span class="category-row-name">@c.Name</span><span class="category-row-count">@c.NoteCount</span>
               </a>
               @* Projeler açıkken altında firmalar listelenir; her firmanın kendi sayfaları vardır. *@
               if (c.Id == projectsId && selectedCategory == projectsId)
               {
                   foreach (var f in companies)
                   {
                       <a class="category-row company-row @(f.Id == selectedCompany ? "active" : "")" asp-action="Index" asp-route-category="@c.Id" asp-route-company="@f.Id">
                           <span>@f.Name</span><span class="category-row-count">@f.NoteCount</span>
                       </a>
                   }
                   <form asp-action="CreateCompany" method="post" class="company-add">
                       @Html.AntiForgeryToken()
                       <input name="name" placeholder="Yeni firma adı" maxlength="100" required aria-label="Yeni firma adı" />
                       <button type="submit" title="Firma ekle">+</button>
                   </form>
               }
           }
           </nav>
        </aside>
        <aside class="note-sidebar" aria-label="Not sayfaları">
           <div class="sidebar-top"><h2>@(companyName ?? "Sayfalar")</h2><span>@Model.Count sayfa</span>
           @if (selectedCompany.HasValue)
           {
               @* Firma adı değiştirme ve (boşsa) silme *@
               <details class="company-tools"><summary>Firma ayarları</summary>
                   <form asp-action="RenameCompany" asp-route-id="@selectedCompany" method="post" class="company-add">
                       @Html.AntiForgeryToken()
                       <input name="name" value="@companyName" maxlength="100" required aria-label="Firma adı" />
                       <button type="submit">Kaydet</button>
                   </form>
                   <form asp-action="DeleteCompany" asp-route-id="@selectedCompany" method="post" class="inline-form" onsubmit="return confirm('Firma silinsin mi? (Sadece sayfası olmayan firma silinebilir.)');">
                       @Html.AntiForgeryToken()
                       <button type="submit" class="danger-link">Firmayı sil</button>
                   </form>
               </details>
           }
           </div>
           @if (canReorder && selectedCategory.HasValue)
           {
               <div class="reorder-hint">
                   <span>@(grouped ? "Sürükle: sırala veya başka alt kategoriye taşı" : Model.Count > 1 ? "Sıralamak için sayfaları sürükle" : "")</span>
                   <a class="subcat-link" href="/Subcategories/@selectedCategory">@(grouped ? "Alt kategoriler" : "Alt kategorilere böl")</a>
               </div>
           }
           <nav class="note-list" data-reorder="@(canReorder ? "true" : "false")">
           @if (canReorder) { @Html.AntiForgeryToken() }
           @foreach (var item in listItems)
           {
               if (item.IsHead)
               {
                   @* Grup başlığı; sürüklenen sayfa başlığın üstüne bırakılırsa o alt kategoriye geçer. *@
                   <div class="note-group @(item.Count == 0 ? "is-empty" : "")" data-sub="@(item.Group?.Id.ToString() ?? "")" role="heading" aria-level="3">
                       <span>@(item.Group?.Name ?? Subcategory.General)</span><b data-group-count>@item.Count</b>
                   </div>
                   continue;
               }
               var n = item.Note!;
               <a class="note-row @(selectedNote?.Id == n.Id ? "active" : "")" draggable="@(canReorder ? "true" : "false")" data-id="@n.Id" asp-action="Index" asp-route-category="@selectedCategory" asp-route-q="@query" asp-route-company="@selectedCompany" asp-route-tag="@selectedTag" asp-route-note="@n.Id">
                   @if (hits.TryGetValue(n.Id, out var hit))
                   {
                       @* Arama sonucu: başlıkta ve pasajda aranan ifade vurgulanır. *@
                       var title = NoteSearch.Split(n.Title, query!);
                       <div class="note-title">@NoteSearch.Highlight(title.Before, title.Match, title.After)</div>
                       <div class="note-snippet"><span class="snippet-where">@hit.Where</span> @NoteSearch.Highlight(hit.Before, hit.Match, hit.After)</div>
                       <div class="note-date">@n.Category?.Name</div>
                   }
                   else
                   {
                       <div class="note-title">@n.Title</div>
                       <div class="note-date">@n.UpdatedAt.ToLocalTime().ToString("dd.MM.yyyy")</div>
                   }
               </a>
           }
           </nav>
        </aside>
        <article class="note-document">
          @if (creating)
          {
              @* Yeni not sağ panelde açılır; kategori ve (Projeler'deyse) firma hazır seçilidir. *@
              var draft = new Note { CategoryId = selectedCategory ?? 0, CompanyId = selectedCompany };
              ViewBag.CancelUrl = Url.Action("Index", new { category = selectedCategory, q = query, company = selectedCompany, note = selectedNoteId });
              <div class="doc-top"><span class="doc-kicker">Yeni not@(categoryName is null ? "" : $" · {categoryName}")@(companyName is null ? "" : $" › {companyName}")</span></div>
              <form asp-action="Create" method="post" enctype="multipart/form-data" class="form-card inline-edit">
                  @Html.AntiForgeryToken()
                  <input type="hidden" name="inline" value="true" />
                  @if (!string.IsNullOrWhiteSpace(query)) { <input type="hidden" name="returnQ" value="@query" /> }
                  <partial name="_Fields" model="draft" />
              </form>
          }
          else if (editing)
          {
              @* Düzenleme sağ panelde açılır; kaydet/vazgeç aynı sayfaya ve aynı nota döner. *@
              NoteLinks.FillText(selectedNote!);
              ViewBag.CancelUrl = Url.Action("Index", new { category = selectedCategory, q = query, company = selectedCompany, note = selectedNote!.Id });
              <div class="doc-top"><span class="doc-kicker">Notu düzenle</span></div>
              <form asp-action="Edit" asp-route-id="@selectedNote.Id" method="post" enctype="multipart/form-data" class="form-card inline-edit">
                  @Html.AntiForgeryToken()
                  <input type="hidden" name="Id" value="@selectedNote.Id" />
                  <input type="hidden" name="inline" value="true" />
                  @if (selectedCategory.HasValue) { <input type="hidden" name="returnCategory" value="@selectedCategory" /> }
                  @if (!string.IsNullOrWhiteSpace(query)) { <input type="hidden" name="returnQ" value="@query" /> }
                  @if (selectedCompany.HasValue) { <input type="hidden" name="returnCompany" value="@selectedCompany" /> }
                  <partial name="_Fields" model="selectedNote" />
              </form>
          }
          else if (selectedNote is not null)
          {
              <div class="doc-top"><span class="doc-kicker">@selectedNote.Category?.Name@if (selectedNote.Subcategory is not null) { <text> › @selectedNote.Subcategory.Name</text> }@if (selectedNote.Company is not null) { <text> › @selectedNote.Company.Name</text> }</span><span class="doc-tools"><button type="button" class="hl-tool" data-hl-tool disabled title="Metni seç, sonra bas (kısayol: H)"><span aria-hidden="true">✎</span> Vurgula</button><a asp-action="Index" asp-route-category="@selectedCategory" asp-route-q="@query" asp-route-company="@selectedCompany" asp-route-note="@selectedNote.Id" asp-route-edit="true">Düzenle</a><partial name="_DeleteForm" model="selectedNote" /></span></div>
              <h2 class="doc-title">@selectedNote.Title</h2>
              <div class="doc-date">Son düzenleme: @selectedNote.UpdatedAt.ToLocalTime().ToString("dd.MM.yyyy HH:mm")</div>
              @* Fosforlu kalem alanı: not metni, kod bölümleri ve ABAP kod örneği (data-seg="-1"). Seçim yapılınca başlıktaki "Vurgula" açılır. *@
              <div class="doc-markable" data-marker-note="@selectedNote.Id" data-stamp="@selectedNote.UpdatedAt.Ticks">
              <div class="doc-body" data-highlight="@(searching ? query!.Trim() : "")"><partial name="_NoteBody" model="selectedNote" /></div>
              @if (!string.IsNullOrWhiteSpace(selectedNote.Code))
              {
                  <h3>ABAP Kod Örneği</h3><pre class="doc-code" tabindex="0"><code data-seg="-1">@NoteBody.RenderRuns(selectedNote.Code)</code></pre>
              }
              </div>
              @if (selectedNote.TagNames.Any()) { <div class="doc-source">Etiketler: @string.Join(", ", selectedNote.TagNames)</div> }
              @if (selectedNote.Source is not null) { <div class="doc-source"><partial name="_Source" model="selectedNote" /></div> }
          }
          else { <div class="reading-empty">@(searching ? "Sonuç bulunamadı. Daha kısa ya da farklı bir ifade dene." : companyName is not null ? "Bu firmada henüz sayfa yok. \"+ Yeni Not\" ile ekleyebilirsin." : "Bu kategori için henüz bir not bulunmuyor.")</div> }
        </article>
    </div>
}
