@model Note
<div class="row-between"><a asp-action="Index">← Notlara dön</a><span><a class="action" asp-action="Edit" asp-route-id="@Model.Id">Düzenle</a><partial name="_DeleteForm" model="Model" /></span></div><article class="detail"><div class="eyebrow">@Model.Category?.Name</div><h1>@Model.Title</h1><p class="meta">@Model.Tags</p><div class="content"><partial name="_NoteBody" model="Model" /></div>@if(!string.IsNullOrWhiteSpace(Model.Code)){<h2>ABAP örneği</h2><pre><code>@Model.Code</code></pre>}@if(!string.IsNullOrEmpty(Model.SourceFile)){<p class="source">Kaynak: @Model.SourceFile @if(Model.SourcePage.HasValue){<span> · Sayfa @Model.SourcePage</span>}</p>}</article>
