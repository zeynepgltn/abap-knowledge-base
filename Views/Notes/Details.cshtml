@model Note
@{ ViewData["Title"] = Model.Title; ViewData["Description"] = $"{Model.Category?.Name}: {Model.Title}"; }
<div class="row-between"><a asp-action="Index">← Notlara dön</a><span><a class="action" asp-action="Edit" asp-route-id="@Model.Id">Düzenle</a><partial name="_DeleteForm" model="Model" /></span></div><article class="detail"><div class="eyebrow">@Model.Category?.Name</div><h1>@Model.Title</h1><p class="meta">@string.Join(", ", Model.TagNames)</p><div class="content"><partial name="_NoteBody" model="Model" /></div>@if(!string.IsNullOrWhiteSpace(Model.Code)){<h2>ABAP örneği</h2><pre><code>@ABAPKnowledgeBase.Services.NoteBody.Plain(Model.Code)</code></pre>}@if(Model.Source is not null){<p class="source"><partial name="_Source" model="Model" /></p>}</article>
