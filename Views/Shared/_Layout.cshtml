@{ /* Okuma ekranı gibi sayfalar ViewData["Wide"] = true ile daha geniş alan kullanır. */ var wrap = ViewData["Wide"] is true ? "wrap wide" : "wrap"; }
<!doctype html><html lang="tr"><head><meta charset="utf-8"><meta name="viewport" content="width=device-width, initial-scale=1"><title>ABAP Bilgi Bankası</title><script>/* Kayıtlı temayı CSS yüklenmeden uygula, sayfa açılırken beyaz parlama olmasın. */try{var t=localStorage.getItem('theme');if(t==='dark'||t==='light')document.documentElement.dataset.theme=t;}catch(e){}</script><link rel="stylesheet" href="~/css/site.css" asp-append-version="true" /></head>
<body><header><div class="@wrap nav"><a class="brand" asp-controller="Notes" asp-action="Index">◈ ABAP Bilgi Bankası</a><nav><button type="button" class="theme-toggle" id="themeToggle" aria-label="Temayı değiştir" title="Temayı değiştir">☾</button><a asp-controller="Notes" asp-action="Index">Notlarım</a><a class="action" asp-controller="Notes" asp-action="Create">+ Yeni Not</a></nav></div></header><main class="@wrap">@if (TempData["Flash"] is string flash) { <div class="flash" role="status">@flash</div> }@RenderBody()</main><footer class="@wrap">Yerel prototip · Kimlik doğrulama olmadan internete açmayın.</footer><script src="~/js/site.js" asp-append-version="true"></script>@await RenderSectionAsync("Scripts",required:false)</body></html>